# ================= QuantTrader 环境变量配置 =================
# 使用方法: 复制本文件为 .env 并填入真实值
#   Windows: copy .env.example .env
#   Linux/macOS: cp .env.example .env
# 注意: .env 已加入 .gitignore, 不会进入代码仓库。
# 环境变量优先于 config/*.json; 未配置的项会自动回退到 JSON 配置。

# 邮箱 SMTP 授权码(163/QQ 等邮箱设置中获取, 不是登录密码)
EMAIL_AUTH_CODE=YOUR_SMTP_AUTH_CODE

# DeepSeek API Key(https://platform.deepseek.com 获取)
DEEPSEEK_API_KEY=sk-YOUR_DEEPSEEK_API_KEY

# TwelveData 免费 API Key(https://twelvedata.com/pricing 免费注册, 用于美股/港股分钟线训练)
TWELVEDATA_API_KEY=YOUR_TWELVEDATA_API_KEY

# ---- 以下为可选项, 不配置时回退到 config/email_config.json ----
# EMAIL_SENDER=your_account@example.com
# EMAIL_SENDER_NAME=QuantTrader Auto
# EMAIL_SMTP_HOST=smtp.163.com
# EMAIL_SMTP_PORT=465
# EMAIL_RECIPIENTS=you@example.com,friend@example.com
